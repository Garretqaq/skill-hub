ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# AUTH_SECRET 可不填：首次启动自动生成并存入 data/settings.json；如需固定值再取消注释
# AUTH_SECRET=long-random-string
MARKETPLACE_REPO_URL=https://<token>@git.gzjunbo.net/junbo/junbo-plugins-market.git
MARKETPLACE_NAME=junbo-plugins-market
# 正向代理，供拉取远程仓库/监听库与 /proxy 路由出网使用；设置页里配置的值优先于此
# PROXY_URL=http://127.0.0.1:7890
